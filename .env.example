# Flagsmith Client SDK (Required for live Flagsmith Cloud Experimentation & trackEvent)
NEXT_PUBLIC_FLAGSMITH_ENV_KEY=
FLAGSMITH_SDK_API_URL=https://edge.api.flagsmith.com/api/v1/

# Optional Flagsmith Management API (Auto-syncs feature weights & creates flags on Flagsmith Cloud)
FLAGSMITH_API_URL=https://api.flagsmith.com
FLAGSMITH_API_KEY=
FLAGSMITH_PROJECT_ID=
FLAGSMITH_ENV_KEY=

# Optional AI Enhancement Keys (Falls back to DevRoast Rubric Engine if omitted)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
